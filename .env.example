#############################################################################
# ShopFlow Production Configuration
# Copy to .env and adjust for your environment
#############################################################################

#============================================================================
# RabbitMQ Cluster Configuration
#============================================================================

RABBITMQ_USER=admin
RABBITMQ_PASS=shopflow123
RABBITMQ_VHOST=shopflow
RABBITMQ_ERLANG_COOKIE=SHOPFLOW_SECRET_COOKIE_2025

# RabbitMQ Resource Limits (production tuning)
RABBITMQ_MEMORY_HIGH_WATERMARK=0.6      # 60% of available memory before blocking
RABBITMQ_DISK_FREE_LIMIT_RELATIVE=1.5   # Ensure 1.5x disk free vs used
RABBITMQ_HEARTBEAT=30                   # Seconds (detect dead connections)

#============================================================================
# Network Ports
#============================================================================

# AMQP (producers/consumers connect via HAProxy)
HAPROXY_AMQP_PORT=5670
HAPROXY_STATS_PORT=8404

# Direct AMQP ports (debugging only — avoid in production)
RABBIT1_AMQP_PORT=5672
RABBIT2_AMQP_PORT=5673
RABBIT3_AMQP_PORT=5674

# Management API ports
RABBIT1_MGMT_PORT=15672
RABBIT2_MGMT_PORT=15673
RABBIT3_MGMT_PORT=15674

# Services
FRONTEND_PORT=3000
CHAOS_SERVICE_PORT=8080
PRODUCER_API_PORT=8090
LOCUST_PORT=8089

#============================================================================
# Consumer Behavior (Fault Tolerance)
#============================================================================

# Fair Dispatch: 1 message per consumer at a time (prevents backlog starvation)
# For high throughput: increase to 5-10, but unfairness may occur
PREFETCH_COUNT=1

# Max retry attempts before dead-lettering to DLX
# After this many NACKs, message is routed to dead_letter_queue
# For critical systems: 5-10, For normal: 3, For aggressive: 1
MAX_RETRIES=3

# Message TTL (Time-To-Live) in milliseconds
# Messages not consumed within this time are auto-dead-lettered
# 60s=60000ms (default), 30s=30000ms (aggressive), 2m=120000ms (lenient)
MESSAGE_TTL_MS=60000

# Consumer reconnect attempts
# On broker failure, consumers retry every N seconds
CONSUMER_RECONNECT_DELAY_SECONDS=5

#============================================================================
# Producer Behavior
#============================================================================

# Delivery mode for order messages
# 1 = not persistent (faster, but data loss on broker crash)
# 2 = persistent (slower, but data survives broker restart) [PRODUCTION]
PRODUCER_DELIVERY_MODE=2

# Confirmation timeout (seconds) when waiting for broker ACK
PRODUCER_CONFIRM_TIMEOUT=10

#============================================================================
# Logging & Observability
#============================================================================

# Log level for all services
# DEBUG (verbose) | INFO (normal) | WARNING (quiet) | ERROR (errors only)
LOG_LEVEL=INFO

# Persist logs to shared volume? (true/false)
ENABLE_LOG_PERSISTENCE=true

# Log file size limit (bytes) before rotation
# 10MB = 10485760, 100MB = 104857600
LOG_MAX_SIZE_BYTES=10485760

#============================================================================
# Load Testing Configuration (Locust)
#============================================================================

# Target ramp-up (concurrent users)
LOCUST_TARGET_USERS=100

# Ramp-up rate (users per second)
LOCUST_RAMP_UP_RATE=10

# Test duration (seconds), 0 = no limit
LOCUST_DURATION_SECONDS=0

#============================================================================
# Feature Flags
#============================================================================

# Enable chaos control panel (allows fault injection)
ENABLE_CHAOS_CONTROL=true

# Enable performance monitoring (higher memory usage)
ENABLE_METRICS=true

# Enable dead-letter audit logging
ENABLE_DLX_AUDIT=true

#============================================================================
# Performance Profiles
#============================================================================

# High Throughput Profile (optimized for speed)
# Uncomment these to override defaults
# PREFETCH_COUNT=10
# PRODUCER_DELIVERY_MODE=1
# MESSAGE_TTL_MS=120000

# High Reliability Profile (optimized for safety)
# Uncomment these to override defaults
# PREFETCH_COUNT=1
# MAX_RETRIES=5
# MESSAGE_TTL_MS=30000
# PRODUCER_DELIVERY_MODE=2

# Development Profile (fast feedback loop)
# Uncomment these to override defaults
# PREFETCH_COUNT=5
# MESSAGE_TTL_MS=10000
# LOG_LEVEL=DEBUG

#============================================================================
# Production Checklist
#============================================================================
# □ Change RABBITMQ_PASS from default
# □ Change RABBITMQ_ERLANG_COOKIE from default
# □ Set RABBITMQ_MEMORY_HIGH_WATERMARK based on available RAM
# □ Set PRODUCER_DELIVERY_MODE=2 for data persistence
# □ Set LOG_LEVEL=INFO or WARNING (not DEBUG)
# □ Enable ENABLE_LOG_PERSISTENCE=true
# □ Review and adjust PREFETCH_COUNT based on workload
# □ Test with Locust before going live
# □ Run validate.sh script to verify all components
# □ Back up configuration to version control
