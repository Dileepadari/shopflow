#############################################################################
# ShopFlow configuration
#
# Copy to .env and adjust. Every variable below is actually read by the code
# or by docker-compose.yml - nothing here is aspirational.
#
#   cp .env.example .env
#############################################################################

#============================================================================
# Credentials
#
# These are demonstration defaults and are deliberately committed so the stack
# works out of the box. Change all three before exposing this to a network.
#============================================================================

RABBITMQ_USER=admin
RABBITMQ_PASS=shopflow123
RABBITMQ_VHOST=shopflow

# Shared secret that lets the three nodes authenticate to each other.
RABBITMQ_ERLANG_COOKIE=SHOPFLOW_SECRET_COOKIE_2025

#============================================================================
# Host ports
#============================================================================

# Unified AMQP entrypoint. All producers and consumers connect here, never to
# a node directly, so HAProxy can absorb a node failure.
HAPROXY_AMQP_PORT=5670
HAPROXY_STATS_PORT=8404

# Direct node AMQP ports - debugging only, bypasses the load balancer.
RABBIT1_AMQP_PORT=5672
RABBIT2_AMQP_PORT=5673
RABBIT3_AMQP_PORT=5674

# RabbitMQ management UI, one per node.
RABBIT1_MGMT_PORT=15672
RABBIT2_MGMT_PORT=15673
RABBIT3_MGMT_PORT=15674

FRONTEND_PORT=3000
CHAOS_SERVICE_PORT=8080
PRODUCER_API_PORT=8090

#============================================================================
# Messaging behaviour
#============================================================================

# Fair dispatch. 1 means a consumer receives the next message only after
# acknowledging the previous one, so a slow consumer cannot hoard a backlog.
# Raise to 5-10 for raw throughput at the cost of even distribution.
PREFETCH_COUNT=1

# How many times a failed message is retried before it is archived in the DLX
# audit log. Enforced by dead_letter_consumer, which counts the x-death header.
MAX_RETRIES=3

# Messages not consumed within this many milliseconds are dead-lettered
# automatically. 60s default; raise it if you intend to stop a consumer for
# longer than that during a demo.
MESSAGE_TTL_MS=60000

#============================================================================
# Logging
#============================================================================

# DEBUG | INFO | WARNING | ERROR - applied to every Python service.
LOG_LEVEL=INFO

# Where the JSONL sinks are written (dead letters, error logs, notification
# audit). Inside containers this is the shared_logs volume; override it when
# running a consumer directly on your machine.
LOG_DIR=/app/logs

#============================================================================
# Browser access
#
# The dashboard is served same-origin through nginx, so CORS is only needed if
# you run the Vite dev server against containerised backends.
#============================================================================

CORS_ORIGINS=http://localhost:3000
