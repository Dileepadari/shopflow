{
  "rabbit_version": "3.13.0",
  "rabbitmq_version": "3.13.0",
  "definition_version": 6,
  "vhosts": [{"name": "shopflow"}],
  "exchanges": [
    {"name": "order.events", "vhost": "shopflow", "type": "fanout", "durable": true, "auto_delete": false, "internal": false, "arguments": {}},
    {"name": "orders.headers", "vhost": "shopflow", "type": "headers", "durable": true, "auto_delete": false, "internal": false, "arguments": {}},
    {"name": "logs.error", "vhost": "shopflow", "type": "direct", "durable": true, "auto_delete": false, "internal": false, "arguments": {}},
    {"name": "logs.info", "vhost": "shopflow", "type": "direct", "durable": true, "auto_delete": false, "internal": false, "arguments": {}},
    {"name": "notifications.topic", "vhost": "shopflow", "type": "topic", "durable": true, "auto_delete": false, "internal": false, "arguments": {}},
    {"name": "order.default", "vhost": "shopflow", "type": "direct", "durable": true, "auto_delete": false, "internal": false, "arguments": {}},
    {"name": "dead_letters", "vhost": "shopflow", "type": "fanout", "durable": true, "auto_delete": false, "internal": false, "arguments": {}}
  ],
  "queues": [
    {"name": "order_payment_queue", "vhost": "shopflow", "durable": true, "auto_delete": false, "arguments": {"x-queue-type": "quorum", "x-dead-letter-exchange": "dead_letters", "x-message-ttl": 60000}},
    {"name": "order_inventory_queue", "vhost": "shopflow", "durable": true, "auto_delete": false, "arguments": {"x-queue-type": "quorum", "x-dead-letter-exchange": "dead_letters", "x-message-ttl": 60000}},
    {"name": "notif_email_queue", "vhost": "shopflow", "durable": true, "auto_delete": false, "arguments": {"x-queue-type": "quorum", "x-dead-letter-exchange": "dead_letters", "x-message-ttl": 60000}},
    {"name": "notif_sms_queue", "vhost": "shopflow", "durable": true, "auto_delete": false, "arguments": {"x-queue-type": "quorum", "x-dead-letter-exchange": "dead_letters", "x-message-ttl": 60000}},
    {"name": "notif_push_queue", "vhost": "shopflow", "durable": true, "auto_delete": false, "arguments": {"x-queue-type": "quorum", "x-dead-letter-exchange": "dead_letters", "x-message-ttl": 60000}},
    {"name": "log_error_queue", "vhost": "shopflow", "durable": true, "auto_delete": false, "arguments": {"x-queue-type": "quorum", "x-dead-letter-exchange": "dead_letters", "x-message-ttl": 60000}},
    {"name": "log_info_queue", "vhost": "shopflow", "durable": true, "auto_delete": false, "arguments": {"x-queue-type": "quorum", "x-dead-letter-exchange": "dead_letters", "x-message-ttl": 60000}},
    {"name": "order_us_queue", "vhost": "shopflow", "durable": true, "auto_delete": false, "arguments": {"x-queue-type": "quorum", "x-dead-letter-exchange": "dead_letters", "x-message-ttl": 60000}},
    {"name": "order_eu_queue", "vhost": "shopflow", "durable": true, "auto_delete": false, "arguments": {"x-queue-type": "quorum", "x-dead-letter-exchange": "dead_letters", "x-message-ttl": 60000}},
    {"name": "order_xml_queue", "vhost": "shopflow", "durable": true, "auto_delete": false, "arguments": {"x-queue-type": "quorum", "x-dead-letter-exchange": "dead_letters", "x-message-ttl": 60000}},
    {"name": "notif_audit_queue", "vhost": "shopflow", "durable": true, "auto_delete": false, "arguments": {"x-queue-type": "quorum", "x-dead-letter-exchange": "dead_letters", "x-message-ttl": 60000}},
    {"name": "dead_letters", "vhost": "shopflow", "durable": true, "auto_delete": false, "arguments": {"x-queue-type": "quorum", "x-message-ttl": 604800000}}
  ],
  "bindings": [
    {"source": "order.events", "destination": "notif_email_queue", "destination_type": "queue", "routing_key": "", "arguments": {}},
    {"source": "order.events", "destination": "notif_sms_queue", "destination_type": "queue", "routing_key": "", "arguments": {}},
    {"source": "order.events", "destination": "notif_push_queue", "destination_type": "queue", "routing_key": "", "arguments": {}},
    {"source": "orders.headers", "destination": "order_us_queue", "destination_type": "queue", "routing_key": "", "arguments": {"x-match": "any", "x-region": "US"}},
    {"source": "orders.headers", "destination": "order_eu_queue", "destination_type": "queue", "routing_key": "", "arguments": {"x-match": "any", "x-region": "EU"}},
    {"source": "orders.headers", "destination": "order_xml_queue", "destination_type": "queue", "routing_key": "", "arguments": {"x-match": "any", "x-type": "XML"}},
    {"source": "logs.error", "destination": "log_error_queue", "destination_type": "queue", "routing_key": "error", "arguments": {}},
    {"source": "logs.error", "destination": "log_error_queue", "destination_type": "queue", "routing_key": "warning", "arguments": {}},
    {"source": "logs.info", "destination": "log_info_queue", "destination_type": "queue", "routing_key": "info", "arguments": {}},
    {"source": "logs.info", "destination": "log_info_queue", "destination_type": "queue", "routing_key": "debug", "arguments": {}},
    {"source": "notifications.topic", "destination": "notif_email_queue", "destination_type": "queue", "routing_key": "notif.email", "arguments": {}},
    {"source": "notifications.topic", "destination": "notif_sms_queue", "destination_type": "queue", "routing_key": "notif.sms", "arguments": {}},
    {"source": "notifications.topic", "destination": "notif_audit_queue", "destination_type": "queue", "routing_key": "notif.#", "arguments": {}},
    {"source": "order.default", "destination": "order_payment_queue", "destination_type": "queue", "routing_key": "order_payment_queue", "arguments": {}},
    {"source": "order.default", "destination": "order_inventory_queue", "destination_type": "queue", "routing_key": "order_inventory_queue", "arguments": {}}
  ],
  "policies": [{"vhost": "shopflow", "name": "ha-policy", "pattern": ".*", "apply-to": "all", "definition": {"ha-mode": "all", "ha-sync-mode": "automatic"}, "priority": 0}],
  "parameters": [],
  "global_parameters": []
}
